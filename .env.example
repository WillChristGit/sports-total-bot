# SportsTotalBot Environment Variables
# Copy this file to .env and fill in your values
# The .env file should be gitignored for security

# API Keys - Sports Data
ODDS_API_KEY=your_api_key_here
NBA_API_KEY=
RAPID_API_KEY=
SPORTSDATAIO_KEY=

# API Keys - LLM (for RLM analysis)
GLM_API_KEY=your_glm_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here  # For Claude
OPENAI_API_KEY=your_openai_key_here  # For GPT

# Notifications (Optional)
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Analysis Settings (Optional - overrides config.yaml)
MIN_EV_THRESHOLD=0.02
MIN_CONFIDENCE=0.55

# RLM Settings (Optional)
RLM_PROVIDER=glm  # glm, claude, or openai
RLM_MAX_CHUNK_SIZE=50000
RLM_MAX_DEPTH=10

# Database (Optional)
DATABASE_PATH=data/sportstotalbot.db

# Logging (Optional)
LOG_LEVEL=INFO
